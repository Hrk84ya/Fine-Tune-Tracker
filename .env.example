# Fine-tune Tracker configuration
# Copy to .env and adjust as needed.

# Server
FT_HOST=127.0.0.1
FT_PORT=8000

# Database (SQLite file path, relative to the working directory)
FT_DB_PATH=finetune_tracker.db

# Dashboard auto-refresh interval in seconds (for "running" runs)
FT_REFRESH_INTERVAL=10

# Stale-run cleanup: a "running" run with no activity for this many minutes
# is marked "failed" by the background scheduler.
FT_STALE_MINUTES=30

# Base URL the SDK uses to reach the backend.
FT_API_URL=http://127.0.0.1:8000
